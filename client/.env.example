# API base URL
# - Empty (default): relative URLs. Works when Express serves the React build on the same
#   origin (recommended for LAN / hosted deployments — only one URL to share with students).
# - Explicit URL: use when client and server are served from different origins.
#   Example: REACT_APP_BACKEND_URL=http://192.168.1.50:5001
REACT_APP_BACKEND_URL=
