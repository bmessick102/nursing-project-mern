# Port the server listens on. Railway injects PORT automatically.
PORT=5001

# REQUIRED. Strong, unique secret used to sign JWTs. The server refuses to start
# without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated list of allowed browser origins (your deployed frontend URL).
# Example: https://your-app.vercel.app,https://your-app-git-main.vercel.app
# Local dev defaults to http://localhost:3000,http://localhost:3001 when unset.
CORS_ORIGIN=

# Initial administrator credentials, seeded on first run if no admin exists.
# Change ADMIN_PASSWORD before the first production deploy.
ADMIN_USERNAME=cuw-admin
ADMIN_PASSWORD=

# Absolute path to the SQLite database file. Defaults to <server>/data/app.db.
# On Railway, set this to a path on the mounted volume, e.g. /data/app.db
DATABASE_PATH=
